#!/usr/bin/env php
<?php

defined('ROOT') or define('ROOT', realpath(__DIR__ . '/..'));
defined('ROOT_URI') or define('ROOT_URI', str_replace('/var/www/html', "", ROOT));

require ROOT . '/db.mysql.php';
require ROOT . '/connectdb.php';

function help() {
  return <<<HELP
HELP;
}

if ($argc > 1) {
  $tombolID = $argv[1];
  $jumlah = (int) $argv[2];

  $minSec = 0.5 * 1000000;
  $maxSec = 5 * 1000000;

  $qTom = "SELECT TombolID, Nama, Prefix FROM tombol WHERE TombolID = '"._escape_string($tombolID)."' AND NA = 'N'";
  $rTom = _query($qTom);
  if (_num_rows($rTom) === 0) {
    echo "tombol_id = {$tombolID}, tidak ditemukan." . PHP_EOL;
    exit;
  }
  $tombol = _fetch_array($rTom);

  for ($i = 0; $i < $jumlah; $i++) {
    $param = [
      "exe" => "cetak_antrian",
      "tid" => $tombolID,
      "prefix" => $tombol['Prefix'],
    ];
    $url = 'http://localhost' .ROOT_URI . '/index_btn.php?' . http_build_query($param);

    $c = curl_init();
    curl_setopt($c, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($c, CURLOPT_URL, $url);
    $out = curl_exec($c);
    echo $out . PHP_EOL;

    usleep(rand($minSec, $maxSec));
  }

  echo "DONE!" . PHP_EOL;
  exit;
} else {
  echo "Anda belum memasukkan argumen <tombol_id> & <jumlah>" . PHP_EOL;
  echo help();
  exit;
}
